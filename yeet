#!/bin/bash

# === Config ===
GIT_REMOTE="github"
STATUS_FILE=".deploy-status"

# === Colors ===
RED='\033[0;31m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
DIM='\033[2m'
BOLD='\033[1m'
NC='\033[0m'

# === Logo ===
logo() {
  echo -e "${DIM}"
  echo '                                  '
  echo '    ▄▄                       ██   '
  echo '     ▀█▄  ██ ██ ▄█▀█▄ ▄█▀█▄ ▀██▀▀ '
  echo '▀▀▀▀▀ ▄█▀ ██▄██ ██▄█▀ ██▄█▀  ██   '
  echo '    ▄█▀    ▀██▀ ▀█▄▄▄ ▀█▄▄▄  ██   '
  echo '            ██                    '
  echo '          ▀▀▀                     '
  echo -e "${NC}"
}

# === Write deploy metadata ===
write_deploy_json() {
  local commit_full commit_short commit_msg branch env_label ts tz timestamp

  commit_full=$(git log --format="%H" -1)
  commit_short=$(git log --format="%h" -1)
  commit_msg=$(git log --format="%s" -1)
  branch=$(git rev-parse --abbrev-ref HEAD)
  env_label="$1"

  # ISO 8601 timestamp with timezone colon (macOS compatible)
  ts=$(date "+%Y-%m-%dT%H:%M:%S%z")
  tz="${ts: -5}"
  timestamp="${ts:0:${#ts}-5}${tz:0:3}:${tz:3}"

  # Escape JSON-unsafe characters in commit message
  commit_msg="${commit_msg//\\/\\\\}"
  commit_msg="${commit_msg//\"/\\\"}"

  cat > .deploy.json <<EOF
{
  "commit": "${commit_short}",
  "commitFull": "${commit_full}",
  "message": "${commit_msg}",
  "branch": "${branch}",
  "environment": "${env_label}",
  "timestamp": "${timestamp}"
}
EOF
}

# === Upload .deploy.json to remote ===
upload_deploy_json() {
  local host="$1" user="$2" pass="$3"
  local target="${host%/}/.deploy.json"

  curl -s -T .deploy.json --user "${user}:${pass}" "$target" 2>/dev/null
}

# === Refresh deploy status for all environments ===
refresh_status() {
  local timestamp
  timestamp=$(date "+%Y-%m-%d %H:%M")
  local output="Deploy Status (updated ${timestamp})\n\n"
  local has_envs=false

  for env_name in "${ENVS[@]}"; do
    has_envs=true
    local h_var="DEPLOY_${env_name}_HOST"
    local u_var="DEPLOY_${env_name}_USER"
    local p_var="DEPLOY_${env_name}_PASS"
    local url_var="DEPLOY_${env_name}_URL"
    local h="${!h_var}"
    local u="${!u_var}"
    local p="${!p_var}"
    local url="${!url_var}"

    if [ -z "$h" ] || [ -z "$u" ] || [ -z "$p" ]; then
      output+="$(printf '%-8s %s' "$env_name" "(missing credentials in .env)")\n"
      continue
    fi

    # Fetch deployed SHA from .git-ftp.log on the server
    local log_url="${h%/}/.git-ftp.log"
    local sha
    sha=$(curl -s --user "${u}:${p}" "$log_url" 2>/dev/null)

    if [ $? -ne 0 ] || [ -z "$sha" ]; then
      output+="$(printf '%-8s %s' "$env_name" "(unreachable or not deployed)")\n"
      continue
    fi

    sha=$(echo "$sha" | tr -d '[:space:]')

    if ! git cat-file -t "$sha" &>/dev/null; then
      output+="$(printf '%-8s %s' "$env_name" "(unknown commit ${sha:0:7})")\n"
      continue
    fi

    local short_hash date_str message behind
    short_hash=$(git log --format="%h" -1 "$sha")
    date_str=$(git log --format="%ai" -1 "$sha" | cut -d' ' -f1)
    message=$(git log --format="%s" -1 "$sha")
    behind=$(git rev-list --count "$sha"..HEAD)

    if [ ${#message} -gt 40 ]; then
      message="${message:0:37}..."
    fi

    local line
    line="$(printf '%-8s %s  %s  %-42s (%s behind HEAD)' \
      "$env_name" "$short_hash" "$date_str" "\"$message\"" "$behind")"
    [ -n "$url" ] && line+="  → $url"
    output+="$line\n"
  done

  if [ "$has_envs" = false ]; then
    output+="No environments found in .env\n"
  fi

  echo -e "$output" > "$STATUS_FILE"

  echo
  echo -e "  ${DIM}─────────────────────────────────────────────${NC}"
  echo -e "$output" | while IFS= read -r line; do
    [ -n "$line" ] && echo -e "  $line"
  done
  echo -e "  ${DIM}─────────────────────────────────────────────${NC}"
  echo -e "  ${DIM}Written to ${STATUS_FILE}${NC}"
}

# === Help ===
show_help() {
  echo
  echo -e "${BOLD}yeet${NC} — FTP deploy script using git-ftp"
  echo
  echo -e "${BOLD}USAGE${NC}"
  echo "  yeet              Interactive deploy (push, init, or status)"
  echo "  yeet -h, --help   Show this help"
  echo
  echo -e "${BOLD}SETUP${NC}"
  echo "  1. Install git-ftp: brew install git-ftp"
  echo "  2. Create a .env in your project root with deploy credentials"
  echo "  3. Optionally create .git-ftp-ignore and .git-ftp-include"
  echo "  4. Run yeet from your project directory"
  echo
  echo -e "${BOLD}ACTIONS${NC}"
  echo "  Push     Incremental deploy — only changed files since last deploy"
  echo "  Init     First-time deploy — uploads everything and sets the baseline"
  echo "  Status   Show deployed commit info for all environments"
  echo
  echo -e "${BOLD}.ENV CONFIGURATION${NC}"
  echo "  Define one or more environments using DEPLOY_<NAME>_* variables:"
  echo
  echo "    DEPLOY_DEV_HOST=ftp://dev.example.com"
  echo "    DEPLOY_DEV_USER=ftp-user"
  echo "    DEPLOY_DEV_PASS=secret"
  echo "    DEPLOY_DEV_URL=https://dev.example.com    (optional, shown in status)"
  echo
  echo "  Repeat with PROD, STAGING, etc. for additional environments."
  echo
  echo -e "${BOLD}BRANCH AWARENESS${NC}"
  echo "  Warns when deploying from a branch other than main."
  echo "  Override with DEPLOY_BRANCH=develop in .env."
  echo
  echo -e "${BOLD}COMPLETION SOUND${NC}"
  echo "  Place a sound file at ~/.config/yeet/sound.mp3"
  echo "  Supports any format afplay handles (.mp3, .wav, .aiff, .m4a)."
  echo "  Falls back to terminal bell if no file is found."
  echo
  echo -e "${BOLD}FILES${NC}"
  echo "  .env              Deploy credentials (required)"
  echo "  .git-ftp-ignore   Files/dirs to exclude from FTP deploy"
  echo "  .git-ftp-include  Force-upload git-ignored dirs (e.g. vendor/)"
  echo "  .deploy-status    Written by yeet after deploy with current status"
  echo "  .deploy.json      Deploy metadata (generated, uploaded to remote)"
  echo
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  show_help
  exit 0
fi

# === Preflight ===
if ! command -v git-ftp &> /dev/null; then
  echo -e "  ${RED}✗ git-ftp is not installed.${NC}"
  echo -e "  Install via: ${BOLD}brew install git-ftp${NC}"
  exit 1
fi

# === Load .env if present ===
if [ -f .env ]; then
  source .env
fi

# === Deploy branch ===
DEPLOY_BRANCH="${DEPLOY_BRANCH:-main}"

# === Select action ===
clear
logo
echo -e "  ${CYAN}1)${NC} Push  ${DIM}(incremental)${NC}"
echo -e "  ${CYAN}2)${NC} Init  ${DIM}(first-time)${NC}"
echo -e "  ${CYAN}3)${NC} Status  ${DIM}(all environments)${NC}"
echo -e "  ${CYAN}q)${NC} Quit"
echo
read -p "  Select action [1/2/3/q]: " ACTION

case $ACTION in
  1) CMD="push" ;;
  2) CMD="init" ;;
  3) CMD="status" ;;
  q|Q) exit 0 ;;
  *)
    echo -e "  ${RED}✗ Invalid selection. Aborting.${NC}"
    exit 1
    ;;
esac

# === Detect environments from DEPLOY_* vars ===
ENVS=()
for var in $(compgen -v); do
  if [[ $var =~ ^DEPLOY_(.+)_(HOST|USER|PASS|URL)$ ]]; then
    ENV_NAME="${BASH_REMATCH[1]}"
    if [[ ! " ${ENVS[@]} " =~ " ${ENV_NAME} " ]]; then
      ENVS+=("$ENV_NAME")
    fi
  fi
done

# === Status: query all environments and exit ===
if [ "$CMD" = "status" ]; then
  refresh_status
  exit 0
fi

# === Select environment ===
clear
logo
if [ ${#ENVS[@]} -eq 0 ]; then
  echo -e "  ${DIM}No environments found in .env${NC}"
  echo -e "  ${DIM}You will be prompted for all values.${NC}"
  echo
  read -p "  Environment name (e.g. DEV, PROD): " LABEL
else
  for i in "${!ENVS[@]}"; do
    env_url_var="DEPLOY_${ENVS[$i]}_URL"
    env_url="${!env_url_var}"
    if [ -n "$env_url" ]; then
      printf "  ${CYAN}%d)${NC} %s  ${DIM}%s${NC}\n" "$((i+1))" "${ENVS[$i]}" "$env_url"
    else
      printf "  ${CYAN}%d)${NC} %s\n" "$((i+1))" "${ENVS[$i]}"
    fi
  done
  echo
  read -p "  Select environment [1-${#ENVS[@]}]: " ENV

  if ! [[ "$ENV" =~ ^[0-9]+$ ]] || [ "$ENV" -lt 1 ] || [ "$ENV" -gt ${#ENVS[@]} ]; then
    echo -e "  ${RED}✗ Invalid selection. Aborting.${NC}"
    exit 1
  fi

  LABEL="${ENVS[$((ENV-1))]}"
fi

# === Resolve config from .env or prompt ===
HOST_VAR="DEPLOY_${LABEL}_HOST"
USER_VAR="DEPLOY_${LABEL}_USER"
PASS_VAR="DEPLOY_${LABEL}_PASS"

URL_VAR="DEPLOY_${LABEL}_URL"

HOST="${!HOST_VAR}"
USER="${!USER_VAR}"
PASS="${!PASS_VAR}"
URL="${!URL_VAR}"

MISSING=""

if [ -z "$HOST" ]; then
  MISSING+=" ${HOST_VAR}"
  read -p "  ${HOST_VAR}: " HOST
fi

if [ -z "$USER" ]; then
  MISSING+=" ${USER_VAR}"
  read -p "  ${USER_VAR}: " USER
fi

clear
logo
echo -e "  Action: ${BOLD}git ftp $CMD${NC}"
echo -e "  Target: ${BOLD}$LABEL${NC}"
echo -e "  Host:   ${CYAN}$HOST${NC}"
[ -n "$URL" ] && echo -e "  URL:    ${CYAN}$URL${NC}"
echo -e "  User:   ${CYAN}$USER${NC}"
echo

if [ -z "$PASS" ]; then
  MISSING+=" ${PASS_VAR}"
  read -s -p "  ${PASS_VAR}: " PASS
  echo
  echo
fi

if [ -n "$MISSING" ]; then
  echo -e "  ${DIM}Tip: Add$MISSING to .env to skip prompts.${NC}"
  echo
fi

# === Branch check ===
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
if [ "$CURRENT_BRANCH" != "$DEPLOY_BRANCH" ]; then
  echo -e "  ${RED}⚠ You're on '${CURRENT_BRANCH}', not '${DEPLOY_BRANCH}'.${NC}"
  read -p "  Deploy anyway? [y/N]: " CONFIRM_BRANCH
  if [[ ! "$CONFIRM_BRANCH" =~ ^[Yy]$ ]]; then
    echo -e "  ${DIM}Aborted.${NC}"
    exit 0
  fi
  echo
fi

git ftp "$CMD" \
  --user "$USER" \
  --passwd "$PASS" \
  --verbose \
  "$HOST"
FTP_EXIT=$?

# === Refresh deploy status after successful deploy ===
if [ $FTP_EXIT -eq 0 ]; then
  echo
  echo -e "  ${GREEN}✓ Deployed to ${BOLD}${LABEL}${NC}"
  [ -n "$URL" ] && echo -e "  ${DIM}→ ${URL}${NC}"

  # Write and upload deploy metadata
  write_deploy_json "$LABEL"
  if upload_deploy_json "$HOST" "$USER" "$PASS"; then
    echo -e "  ${DIM}→ .deploy.json uploaded${NC}"
  else
    echo -e "  ${DIM}⚠ .deploy.json upload failed (non-critical)${NC}"
  fi

  # Play completion sound
  SOUND_FILE="$HOME/.config/yeet/sound.mp3"
  if [ -f "$SOUND_FILE" ]; then
    afplay "$SOUND_FILE" &
  else
    printf '\a'
  fi

  refresh_status
fi